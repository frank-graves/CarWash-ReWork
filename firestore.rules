rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Todo denegado por defecto.
    match /{document=**} {
      allow read, write: if false;
    }

    // Solo usuarios autenticados (anónimos incluidos) pueden tocar datos.
    // Un workspace se considera "reclamado" si el usuario autenticado
    // tiene un doc en `workspaces/{id}/operators/{uid}`.
    function isWorkspaceMember(workspaceId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/operators/$(request.auth.uid));
    }

    match /workspaces/{workspaceId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;
      allow update, delete: if false;

      // El docId es el uid real de Firebase Auth: nadie puede crear un operador
      // que no sea él mismo, y por tanto nadie puede ascender a otro. El rol vive
      // dentro del payload cifrado, así que las reglas no pueden leerlo (no tienen
      // la Master Key): la autorización por rol es de la capa de aplicación, y el
      // alta de operadores por invitación llega en la Fase 6.
      match /operators/{operatorId} {
        allow create: if request.auth != null
                      && request.auth.uid == operatorId;
        allow read:   if isWorkspaceMember(workspaceId);
        // Self-update acotado al backfill v2 → v3. El operador activo puede
        // añadirse `rolePublic: 'owner'` (v2 no distinguía roles y el primer
        // operador que se auto-registró siempre fue el dueño) y bumpear
        // schemaVersion. Cualquier otro cambio en el mismo update lo rechaza.
        // `delete` sigue prohibido: nadie borra operadores, ni siquiera el owner.
        allow update: if request.auth != null
                      && request.auth.uid == operatorId
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['rolePublic', 'schemaVersion'])
                      && request.resource.data.rolePublic == 'owner';
        allow delete: if false;
      }

      match /washers/{washerId} {
        allow read, write: if isWorkspaceMember(workspaceId);
      }

      match /settings/{settingId} {
        allow read:  if isWorkspaceMember(workspaceId);
        // Solo el owner puede mutar settings. El rol vive en claro en el doc del
        // operador precisamente para que esta regla no requiera descifrar el PII.
        allow write: if isWorkspaceMember(workspaceId)
                     && get(/databases/$(database)/documents/workspaces/$(workspaceId)/operators/$(request.auth.uid)).data.rolePublic == 'owner';
      }

      match /customers/{customerId} {
        allow read, write: if isWorkspaceMember(workspaceId);
      }

      match /transactions/{transactionId} {
        allow read:   if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId);
        allow update, delete: if false; // ledger inmutable
      }
    }
  }
}
