---
// src/ui/layouts/BaseLayout.astro
// Layout ÃƒÆ’Ã‚Âºnico de la aplicaciÃƒÆ’Ã‚Â³n. Todo el CSS es local: ni una fuente, ni un icono,
// ni un script desde un CDN de terceros. Si algo no estÃƒÆ’Ã‚Â¡ en este bundle, no se carga.
import '@styles/reset.css';
import '@styles/tokens.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#09090b" />
    <!-- Los datos de un negocio no se indexan. Ni aquÃƒÆ’Ã‚Â­ ni en ningÃƒÆ’Ã‚Âºn sitio. -->
    <meta name="robots" content="noindex, nofollow" />
    <!-- Los dos ÃƒÆ’Ã‚Âºnicos orÃƒÆ’Ã‚Â­genes que la app toca. El preconnect abre el TCP+TLS
         mientras el bundle todavÃƒÆ’Ã‚Â­a se estÃƒÆ’Ã‚Â¡ descargando: en una conexiÃƒÆ’Ã‚Â³n frÃƒÆ’Ã‚Â­a a
         Firestore eso son varios cientos de milisegundos que nadie ve pero
         todos esperan. Ni un tercero mÃƒÆ’Ã‚Â¡s en esta lista. -->
    <link rel="preconnect" href="https://firestore.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://identitytoolkit.googleapis.com" crossorigin />
    <link rel="dns-prefetch" href="https://firestore.googleapis.com" />
    <link rel="dns-prefetch" href="https://identitytoolkit.googleapis.com" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="ECW" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>Exclusivo Car Wash</title>
    <!-- El tema guardado se aplica antes de que cargue el bundle: sin esto, la
         tablet pinta un frame con el tema del sistema y salta al elegido despuÃƒÆ’Ã‚Â©s.
         Va inline a propÃƒÆ’Ã‚Â³sito: un mÃƒÆ’Ã‚Â³dulo llegarÃƒÆ’Ã‚Â­a tarde para evitar el flash. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('carwash-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (e) {
          /* localStorage bloqueado (modo privado): se queda con el tema del sistema */
        }
      })();
    </script>
    <!-- El splash tapa el hueco entre el primer paint y el primer render de
         Preact: sin ÃƒÆ’Ã‚Â©l, la tablet enseÃƒÆ’Ã‚Â±a un rectÃƒÆ’Ã‚Â¡ngulo vacÃƒÆ’Ã‚Â­o durante el
         bootstrap de Firebase y parece que la app se colgÃƒÆ’Ã‚Â³. Inline y aquÃƒÆ’Ã‚Â­
         arriba para que exista antes del primer paint. -->
    <style is:inline>
      #ecw-splash {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-bg);
        z-index: 9999;
        opacity: 1;
        transition: opacity 280ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      /* El logo no aparece: entra. Un rectÃƒÆ’Ã‚Â¡ngulo que ya estÃƒÆ’Ã‚Â¡ ahÃƒÆ’Ã‚Â­ al encender la
         pantalla se lee como un fallo; uno que llega, como una app. */
      #ecw-splash img {
        opacity: 0;
        transform: scale(0.72); filter: blur(14px);
        animation: ecwSplashIn 1400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      #ecw-splash.ecw-splash-out {
        opacity: 0;
        pointer-events: none;
      }

      @keyframes ecwSplashIn {
        to {
          opacity: 1;
          transform: scale(1);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        #ecw-splash img {
          animation: none;
          opacity: 1;
          transform: none;
        }
      }
    </style>
    <script>
      // El SW solo se registra en producciÃƒÆ’Ã‚Â³n. En dev, el cache-first
      // interferirÃƒÆ’Ã‚Â­a con el HMR de Vite y verÃƒÆ’Ã‚Â­as CSS viejo tras guardar.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {
            // Un registro fallido no rompe la app: la prÃƒÆ’Ã‚Â³xima visita reintenta.
            // Sin console.warn: en la tablet del lavadero nadie lee la consola.
          });
        });
      }
    </script>
  </head>
  <body>
    <div id="ecw-splash" aria-hidden="true">
      <img src="/icon.webp" alt="" width="240" height="240" />
    </div>

    <slot />

    <script is:inline>
      // El splash se retira cuando `mountApp` ya sabe quÃƒÆ’Ã‚Â© pintar, no cuando
      // termina de pintarlo: mantenerlo hasta el primer dato de Firestore
      // cambiarÃƒÆ’Ã‚Â­a un hueco por una pantalla de carga eterna. El temporizador
      // de 5s es la red de seguridad: si el arranque se cuelga, el operador
      // no queda encerrado mirando un logo.
      var __ecwSplashShownAt = Date.now();
      window.__ecwHideSplash = function () {
        var el = document.getElementById('ecw-splash');
        if (!el) return;
        var elapsed = Date.now() - __ecwSplashShownAt;
        var wait = Math.max(0, 1600 - elapsed);
        setTimeout(function () {
          el.classList.add('ecw-splash-out');
          setTimeout(function () { el.remove(); }, 500);
        }, wait);
      };
      setTimeout(window.__ecwHideSplash, 6000);
    </script>
  </body>
</html>
